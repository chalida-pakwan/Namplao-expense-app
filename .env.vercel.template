# Environment Variables for Vercel Deployment
# Copy these to Vercel Dashboard → Settings → Environment Variables

# === STEP 1: Add Placeholder Values First ===
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ_placeholder_anon_key_will_replace_after_supabase_setup
SUPABASE_SERVICE_ROLE_KEY=eyJ_placeholder_service_key_will_replace_after_supabase_setup

# === App Configuration ===
NEXT_PUBLIC_APP_NAME=แอพ รายรับ-รายจ่าย สำหรับนายหน้า
NEXT_PUBLIC_APP_VERSION=1.0.0

# === Security (Generate random 32+ chars) ===
NEXTAUTH_SECRET=change-this-to-random-32-character-string-minimum
NEXTAUTH_URL=https://your-vercel-app-url.vercel.app

# === Optional ===
VERCEL_ENV=production

# =====================================================
# STEP 2: After Supabase Setup, Replace These Values:
# =====================================================

# Replace with actual Supabase values:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.real_anon_key
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.real_service_key

# Replace with actual deployment URL:
# NEXTAUTH_URL=https://namplao-expense-app.vercel.app

# Generate random secret:
# NEXTAUTH_SECRET=use-random-generator-for-32-plus-characters
